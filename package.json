{
  "name": "rps-chess-ai-arena-ts",
  "version": "2.0.0",
  "description": "Đấu trường AI Cờ Đấm - Lá - Kéo 9x9 (TypeScript Hexagonal Architecture + DDD)",
  "main": "dist/server/main.js",
  "scripts": {
    "build:server": "tsc -p server/tsconfig.json",
    "build:client": "esbuild client/src/index.ts --bundle --outfile=client/dist/app.js --platform=browser --target=es2020",
    "build": "npm run build:server && npm run build:client",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "start": "npm run build && node dist/server/main.js",
    "test": "npm run build && node dist/server/adapters/inbound/cli/ArenaCliRunner.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.3"
  }
}
